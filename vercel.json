{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "backend/app/**",
      "excludeFiles": "{backend/.venv/**,backend/.pytest_cache/**,backend/tests/**,backend/conftest.py,backend/.env,backend/.env.example,backend/database_setup.sql,backend/pyproject.toml,backend/app/**/__pycache__/**,backend/app/**/*.pyc,backend/app/**/*.pyo}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
